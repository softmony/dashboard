{
    "name": "softmony/dashboard",
    "description": "Reusable Livewire and Blade admin UI for Laravel (Tailwind, Alpine, Livewire).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "blade",
        "admin",
        "tailwind",
        "alpine",
        "dashboard"
    ],
    "homepage": "https://github.com/softmony/dashboard",
    "support": {
        "issues": "https://github.com/softmony/dashboard/issues",
        "source": "https://github.com/softmony/dashboard"
    },
    "authors": [
        {
            "name": "Softmony",
            "homepage": "https://github.com/softmony"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Softmony\\Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softmony\\Dashboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Softmony\\Dashboard\\DashboardServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
